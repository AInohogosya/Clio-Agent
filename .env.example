# Clio Agent 3 Beta — every setting the agent reads from the environment.
#
# Copy to `.env` and edit. `ethos` reads it on every invocation: `./.env` if the
# command was typed in a directory that has one, otherwise this checkout's, and
# `$ETHOS_ENV_FILE` if you name a file instead. Nothing here is required — the
# defaults run an agent — and nothing here overrides a variable you export:
#
#     ETHOS_DSN=postgresql://… ethos up      # this wins over the file, on purpose
#
# `.env` is gitignored. This file is the one that is not, so it holds names and
# shapes only, and every value below is a placeholder. The agent's own secrets
# (bot tokens, model keys) belong in its home rather than here — see
# `ethos doctor`, which lists what is present and what each open door is missing.


# ----------------------------------------------------------------- where things are

# The agent's own home: memory, journals, sockets, the secret vault, logs.
# Read by `ethos up` and by every process it starts. Default: ~/.ethos
# ETHOS_HOME=~/.ethos

# Where config/*.yaml is read from. Rarely needed — the checkout's `config/` is
# found without it — and the setting a deployment uses when the checkout is not
# where the code is. Same as the `--config-dir` flag.
# ETHOS_CONFIG_DIR=/opt/ethos/config

# A `.env` to read instead of looking for one. Named rather than searched for, so
# a launcher that starts the agent from a service manager can point it at the
# file it manages.
# ETHOS_ENV_FILE=/etc/ethos/ethos.env


# ----------------------------------------------------------------------- the database

# The one hard dependency: PostgreSQL 16 with the `vector` and `pg_trgm`
# extensions. `ethos up` runs `scripts/ensure_postgres.sh up`, which leaves an
# already-answering database alone and otherwise brings this one up on
# 127.0.0.1:5433 — which is what this default names. Set it to point at your own.
# ETHOS_DSN=postgresql://ethos:ethos@127.0.0.1:5433/ethos

# How the local cluster is built, when `scripts/ensure_postgres.sh` builds it.
# ETHOS_PG_MAJOR=16
# ETHOS_PGVECTOR_VERSION=0.8.6
# ETHOS_PGDATA=data/pgdata
# ETHOS_PG_READY_TIMEOUT=60

# `hashing` swaps the embedding model for a hash function: no download, no
# 1.3 GB model, and no semantic memory. For a test machine, not for an agent you
# intend to remember anything with. Same as `ETHOS_EMBEDDING` in `ethos doctor`.
# ETHOS_EMBEDDING=hashing

# The rest of the embedding knobs, for an agent that is too fat to run.
#
# Only two processes load a model — `ethos-gateway`, which serves the embedding
# route, and `ethos-core`, which embeds on every cycle. The toolhost and the
# workers ask the gateway over its socket rather than each holding their own
# ~1.2 GB ONNX session, so `workers.count` no longer multiplies the largest
# allocation in the supervisor.

# A smaller model. `bge-small-en-v1.5` is 0.067 GB against `bge-large`'s 1.2 GB
# and is 384-dimensional, so it needs DIM set with it: the embedding columns are
# `vector(1024)`, and a mismatch is refused at start-up rather than half-applied.
# Note that memories already in the store were embedded by the *old* model, so
# this is a migration, not a toggle.
# ETHOS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# ETHOS_EMBEDDING_DIM=384

# ONNX intra-op threads. fastembed's default of "however many cores this machine
# has" sizes a thread arena this workload never uses. One is the default.
# ETHOS_EMBEDDING_THREADS=1

# Where the ONNX weights are cached between runs. Unset means a directory under
# the agent's own data directory; set it to keep the download on a volume that
# survives a rebuild.
# ETHOS_EMBEDDING_CACHE=/var/lib/ethos/models


# ----------------------------------------------------------------------- the interface

# The port the interface bridge serves on, and the one `ethos up` opens. The
# same value is in `channels.web.http_port`.
# ETHOS_WEB_PORT=8720

# The token the bridge requires, when `channels.web.auth_token_env` names it.
# Generated and written by the settings screen; set it here only for a headless
# deployment that has no screen.
# ETHOS_WEB_TOKEN=

# The Node binary the supervisor starts the interface bridge with. `ethos up`
# sets this to whatever it installed the bridge's dependencies with, so the child
# cannot end up on a different Node than the one its modules were resolved by.
# ETHOS_NODE=/opt/homebrew/bin/node


# ------------------------------------------------------------------------- behaviour

# INFO, DEBUG, WARNING, ERROR.
# ETHOS_LOG_LEVEL=INFO

# Any non-empty value stops `ethos gateway` connecting to a database at all —
# the one process that can run without one.
# ETHOS_NO_DB=1

# Set either of these to keep `ethos up` from touching a browser, which is what a
# launcher and a CI run want. `--no-open` says the same thing on the command line.
# ETHOS_NO_OPEN=1

# How long `ethos up` waits for the agent's first sign of life, in seconds. The
# default is 180 and it is generous on purpose: the agent loads its embedder and
# reconciles its journals before its first cycle. Same as `--wait`.
# ETHOS_AGENT_WAIT_S=180


# ----------------------------------------------------------------------- the doors

# A door is configured in two places, and the file can only name the variable a
# token lives in: `config/channels.yaml` says `telegram.enabled: true` and
# `token_env: TELEGRAM_BOT_TOKEN`, and the token itself is set here or written
# into `$ETHOS_HOME/channels.yaml` by the settings screen. `ethos doctor` prints,
# for each door, whether it is on and what it is still missing.

# TELEGRAM_BOT_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# DISCORD_BOT_TOKEN=
# ETHOS_EMAIL_ADDRESS=
# ETHOS_EMAIL_PASSWORD=
# ETHOS_EMAIL_IMAP_HOST=
# ETHOS_EMAIL_SMTP_HOST=


# ------------------------------------------------------------------ the model providers

# With no key here the agent still starts, still journals, and still runs its
# reflex rules — and every model call fails loudly at the gateway. That is a
# deliberate state rather than a broken install, and `ethos doctor` reports it as
# "absent (optional provider)" rather than as a failure. Which model is used is
# `models.base` in `config/models.yaml`, or the base model the settings screen
# wrote into your home.

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
