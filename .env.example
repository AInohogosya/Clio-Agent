# Clio Agent 3.1 — every setting the agent reads from the environment.
#
# Copy to `.env` and edit. `clio` reads it on every invocation: `./.env` if the
# command was typed in a directory that has one, otherwise this checkout's, and
# `$CLIO_ENV_FILE` if you name a file instead. Nothing here is required — the
# defaults run an agent — and nothing here overrides a variable you export:
#
#     CLIO_DSN=postgresql://… clio up          # this wins over the file, on purpose
#
# `.env` is gitignored. This file is the one that is not, so it holds names and
# shapes only, and every value below is a placeholder. The agent's own secrets
# (bot tokens, model keys) belong in its home rather than here — see
# `clio doctor`, which lists what is present and what each open door is missing.


# ----------------------------------------------------------------- where things are

# The agent's own home: memory, journals, sockets, the secret vault, logs.
# Read by `ethos up` and by every process it starts. Default: ~/.ethos
# CLIO_HOME=~/.ethos

# Where config/*.yaml is read from. Rarely needed — the checkout's `config/` is
# found without it — and the setting a deployment uses when the checkout is not
# where the code is. Same as the `--config-dir` flag.
# CLIO_CONFIG_DIR=/opt/clio/config

# A `.env` to read instead of looking for one. Named rather than searched for, so
# a launcher that starts the agent from a service manager can point it at the
# file it manages.
# CLIO_ENV_FILE=/etc/clio/clio.env


# ----------------------------------------------------------------------- the database

# The one hard dependency: PostgreSQL 16 with the `vector` and `pg_trgm`
# extensions. `clio up` runs `scripts/ensure_postgres.sh up`, which leaves an
# already-answering database alone and otherwise brings this one up on
# 127.0.0.1:5433 — which is what this default names. Set it to point at your own.
# CLIO_DSN=postgresql://ethos:ethos@127.0.0.1:5433/ethos

# How the local cluster is built, when `scripts/ensure_postgres.sh` builds it.
# CLIO_PG_MAJOR=16
# CLIO_PGVECTOR_VERSION=0.8.6
# CLIO_PGDATA=data/pgdata
# CLIO_PG_READY_TIMEOUT=60

# `hashing` swaps the embedding model for a hash function: no download, no
# 1.3 GB model, and no semantic memory. For a test machine, not for an agent you
# intend to remember anything with. Same as `CLIO_EMBEDDING` in `clio doctor`.
# CLIO_EMBEDDING=hashing

# The rest of the embedding knobs, for an agent that is too fat to run.
#
# Only two processes load a model — `clio-gateway`, which serves the embedding
# route, and `clio-core`, which embeds on every cycle. The toolhost and the
# workers ask the gateway over its socket rather than each holding their own
# ~1.2 GB ONNX session, so `workers.count` no longer multiplies the largest
# allocation in the supervisor.

# A smaller model. `bge-small-en-v1.5` is 0.067 GB against `bge-large`'s 1.2 GB
# and is 384-dimensional, so it needs DIM set with it: the embedding columns are
# `vector(1024)`, and a mismatch is refused at start-up rather than half-applied.
# Note that memories already in the store were embedded by the *old* model, so
# this is a migration, not a toggle.
# CLIO_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# CLIO_EMBEDDING_DIM=384

# ONNX intra-op threads. fastembed's default of "however many cores this machine
# has" sizes a thread arena this workload never uses. One is the default.
# CLIO_EMBEDDING_THREADS=1

# Where the ONNX weights are cached between runs. Unset means a directory under
# the agent's own data directory; set it to keep the download on a volume that
# survives a rebuild.
# CLIO_EMBEDDING_CACHE=/var/lib/ethos/models


# ----------------------------------------------------------------------- the interface

# The port the interface bridge serves on, and the one `clio up` opens. The
# same value is in `channels.web.http_port`.
# CLIO_WEB_PORT=8720

# The token the bridge requires, when `channels.web.auth_token_env` names it.
# Generated and written by the settings screen; set it here only for a headless
# deployment that has no screen.
# CLIO_WEB_TOKEN=

# The Node binary the supervisor starts the interface bridge with. `clio up`
# sets this to whatever it installed the bridge's dependencies with, so the child
# cannot end up on a different Node than the one its modules were resolved by.
# CLIO_NODE=/opt/homebrew/bin/node


# ------------------------------------------------------------------------- behaviour

# INFO, DEBUG, WARNING, ERROR. DEBUG is the default: the structured stream
# carries every event the program emits.
# CLIO_LOG_LEVEL=DEBUG

# Directory for the exhaustive JSONL capture (user actions, model requests and
# responses with exposed reasoning, settings changes). Defaults to
# ~/.ethos/data/logs; set CLIO_EXHAUSTIVE_LOG=0 to disable the sink entirely.
# CLIO_EXHAUSTIVE_LOG_DIR=/path/to/dir
# CLIO_EXHAUSTIVE_LOG=0

# Any non-empty value stops `clio gateway` connecting to a database at all —
# the one process that can run without one.
# CLIO_NO_DB=1

# Set either of these to keep `clio up` from touching a browser, which is what a
# launcher and a CI run want. `--no-open` says the same thing on the command line.
# CLIO_NO_OPEN=1

# How long `clio up` waits for the agent's first sign of life, in seconds. The
# default is 180 and it is generous on purpose: the agent loads its embedder and
# reconciles its journals before its first cycle. Same as `--wait`.
# CLIO_AGENT_WAIT_S=180

# Four-level safety system (docs/safety-levels.md). 1=dialogue-only, no commands.
# 2=every command on approval. 3=internet commands on approval, rest automatic.
# 4=no approval. Default 3 (config/permissions.yaml); `clio safety` shows the
# effective level, `clio safety set 1|2|3|4` switches it live.
# CLIO_SAFETY_LEVEL=3


# ----------------------------------------------------------------------- the doors

# A door is configured in two places, and the file can only name the variable a
# token lives in: `config/channels.yaml` says `telegram.enabled: true` and
# `token_env: TELEGRAM_BOT_TOKEN`, and the token itself is set here or written
# into `$CLIO_HOME/channels.yaml` by the settings screen. `clio doctor` prints,
# for each door, whether it is on and what it is still missing.

# TELEGRAM_BOT_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# DISCORD_BOT_TOKEN=
# CLIO_EMAIL_ADDRESS=
# CLIO_EMAIL_PASSWORD=
# CLIO_EMAIL_IMAP_HOST=
# CLIO_EMAIL_SMTP_HOST=

# LINE's two credentials, and they are worth one line each because the console
# calls them both "secret" and swapping them is a 401 on every delivery:
# LINE_CHANNEL_ACCESS_TOKEN authorises what goes out, LINE_CHANNEL_SECRET is what
# every inbound request is signed with.
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=

# Microsoft Teams, through the Bot Framework. Both values come from the bot's
# registration — the App ID is what every inbound token names as its audience.
# TEAMS_APP_ID=
# TEAMS_APP_PASSWORD=

# Google Chat. The first two are a service account's email and PEM private key,
# straight out of the JSON downloaded from the Cloud console. The private key is
# the one credential a settings form cannot hold — a PEM block is about 1700
# characters and the form caps a credential at 1024 — so it lives here. A literal
# \n is read as a newline, which is how a PEM key survives an env file.
# The audience is what the Chat app was configured with as its authentication
# audience: the Cloud project number, or the endpoint URL.
# GOOGLE_CHAT_CLIENT_EMAIL=
# GOOGLE_CHAT_PRIVATE_KEY=
# GOOGLE_CHAT_AUDIENCE=


# ------------------------------------------------------------------ the model providers

# With no key here the agent still starts, still journals, and still runs its
# reflex rules — and every model call fails loudly at the gateway. That is a
# deliberate state rather than a broken install, and `clio doctor` reports it as
# "absent (optional provider)" rather than as a failure. Which model is used is
# `models.base` in `config/models.yaml`, or the base model the settings screen
# wrote into your home.

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# The quality tiers are only as real as the keys behind them. The catalogue
# (`config/models.yaml`) scores `claude-sonnet-4-5` 0.93, `o3` 0.92 and
# `gemini-2.5-pro` 0.91 against the T3 floor of 0.90 — but an entry with no
# key is a dead entry, and a deployment whose only keys are free-tier ones
# routes its most consequential work to whatever is left (measured over
# 2026-11-08..10: 8,149 calls to one free model, 580 failed solver attempts).
# Adding one frontier key above is the single highest-leverage setting on
# this file. After adding it, point the base model at the frontier entry:
# `config/base_model.yaml` (or `~/.ethos/base_model.yaml`), provider
# `anthropic`, model `claude-sonnet-4-5` — the pinned base model is exempt
# from the quality floor and is returned whenever eligible, so T3 work
# lands on it without touching the catalogue. The H2 caps in
# `config/permissions.yaml` bound what it can spend.
# The base model's key (`config/base_model.yaml` names this variable). This is
# the one model the agent and its sub-agents think with; the catalogue above is
# failover capacity. NVIDIA NIM is OpenAI-compatible, so one key serves it.
# NVIDIA_API_KEY=
# The failover routes' key: the two OpenRouter entries in `config/models.yaml`
# (`deepseek/deepseek-chat` and `nvidia/nemotron-3.5-super-vl:free`) name this
# variable. It is not the base model's credential — that one is named by
# `config/base_model.yaml` — and it is not read by the interface settings
# screen, which writes a base model into the agent's own home.
# OPENROUTER_API_KEY=
# Overrides for the sub-agent programs (Foundry, APEX), which are routed
# through this agent's gateway and normally need no keys of their own.
# CLIO_GATEWAY_URL=http://127.0.0.1:8700
